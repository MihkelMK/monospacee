{
  "name": "monospacee",
  "version": "2.0.0",
  "private": false,
  "scripts": {
    "dev": "vite dev --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . --cache --cache-strategy content && eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^3.2.2",
    "@picocss/pico": "2.1.1",
    "@sveltejs/adapter-node": "6.0.4",
    "@sveltejs/kit": "3.1.1",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@types/eslint": "9.6.1",
    "@types/html-escaper": "3.0.4",
    "@types/node": "24.19.2",
    "@websites/eslint-config": "git+https://git.kodu.lenn.uk/websites/eslint-config.git#v1.0.1",
    "@zerodevx/svelte-img": "2.1.2",
    "eslint": "10.15.0",
    "mdsvex": "0.12.7",
    "prettier": "3.10.1",
    "prettier-plugin-svelte": "4.1.1",
    "sass": "1.99.0",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "svelte-meta-tags": "4.7.0",
    "tslib": "2.8.1",
    "typescript": "6.0.3",
    "url": "0.11.4",
    "vite": "8.1.6"
  },
  "type": "module",
  "dependencies": {
    "@ethercorps/sveltekit-og": "4.4.0",
    "@fontsource-variable/roboto-mono": "5.2.8",
    "@fontsource/share-tech-mono": "5.2.7",
    "@jsdevtools/rehype-toc": "3.0.2",
    "html-escaper": "3.0.3",
    "iconify-icon": "3.0.2",
    "rehype-preset-minify": "7.0.1",
    "rehype-rewrite": "4.0.4",
    "rehype-shift-heading": "2.0.0",
    "rehype-slug": "6.0.0",
    "remark-capitalize-headings": "3.0.0",
    "remark-sectionize": "2.1.0",
    "remark-squeeze-paragraphs": "6.0.0",
    "runed": "0.38.0"
  },
  "engines": {
    "node": "^24.0.0"
  },
  "packageManager": "pnpm@12.21.0",
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  }
}
